{
  "name": "coral-club",
  "version": "0.1.0",
  "private": true,
  "description": "Coral Club: монорепозиторий сервисов (apps/*) и общих пакетов (packages/*). См. README.md.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @coral/shop --",
    "build": "npm run build -w @coral/shop && node -e \"const fs=require('fs');fs.rmSync('out',{recursive:true,force:true});fs.cpSync('apps/shop/out','out',{recursive:true})\"",
    "images:sync": "npm run images:sync -w @coral/shop",
    "build:labspace": "npm run build:labspace -w @coral/shop",
    "lint": "eslint",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "typescript": "^5"
  }
}
