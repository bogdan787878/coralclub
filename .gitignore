# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/apps/*/.next/
/out/
/apps/*/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling / scratch
.claude/
/img/
dist/

# licensed fonts: ship inside the bundle, never in the public repo
/apps/shop/public/fonts/*.woff
/apps/shop/public/fonts/*.woff2

# Layout: собирается из packages/layout (dist/) и копируется в public магазина перед dev/build
/apps/shop/public/layout/
/packages/*/dist/
/apps/shop/public/cart/
